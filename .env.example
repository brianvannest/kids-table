# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Atlas > your cluster > Connect > Drivers. Replace <db_password> with the database user's password.
MONGODB_URI=

# Optional. The database name. Defaults to kidstable.
MONGODB_DB=

# A long random secret the sign-in system uses to protect sessions (at least 32 characters).
# Make it yourself in your own terminal and paste it here. Never share it or commit it.
BETTER_AUTH_SECRET=

# The address of the app. Locally this is http://localhost:3000. On the live site, use its address.
BETTER_AUTH_URL=http://localhost:3000

# The email of the one owner. The account created with this email becomes the owner, and
# everyone else starts out waiting for approval.
OWNER_EMAIL=
